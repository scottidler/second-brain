[Unit]
Description=cortex - Obsidian vault governance daemon (second-brain)
After=default.target

[Service]
Type=simple
Environment="PATH=/home/tester/.local/share/mise/shims:/home/tester/.local/bin:/home/tester/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/tester/.cargo/bin/sb cortex --vault /home/tester/repos/scottidler/obsidian --log-level info daemon --start
Restart=on-failure
RestartSec=5
WorkingDirectory=/home/tester

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/tester/repos/scottidler/obsidian /golden-xdg-data-home/sb
PrivateTmp=true

[Install]
WantedBy=default.target
