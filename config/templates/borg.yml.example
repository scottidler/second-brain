# borg config - Obsidian ingestion daemon
# Installed by `sb bootstrap` to ~/.config/sb/borg.yml if absent.
# Fields use kebab-case; the Rust struct (borg::config::Config) translates to snake_case via serde.

server:
  # Default bind is 0.0.0.0 to preserve the LAN ingest path (e.g. the laptop's
  # Firefox extension POSTing to desk.lan:8181). On an exposed network the
  # write routes (/ingest, /ingest/file, /note) are reachable by anyone who can
  # reach this port unless you set auth-token below; /health* stays open.
  host: "0.0.0.0"
  port: 8181
  # Optional bearer-token auth for the write routes. Like telegram.bot-token,
  # this is a secret REFERENCE - an env-var name or a file path - resolved at
  # startup, NOT a literal token. When set, requests must carry
  # `Authorization: Bearer <resolved-token>`; configure the same token in the
  # Firefox extension options. When unset, the routes are unauthenticated
  # (backward compatible). On a non-loopback bind with no token, the daemon
  # logs a WARN at startup naming the exposure.
  # auth-token: BORG_AUTH_TOKEN

vault:
  # Set root-path to your Obsidian vault, or leave it commented out and
  # pass --vault on the CLI / run from a directory containing a .obsidian/
  # subdirectory. With root-path unset, the resolver errors with a clear
  # "vault root not set" message rather than guessing.
  # root-path: ~/path/to/your/vault
  inbox-path: inbox
  vault-name: obsidian

# Local Whisper transcription service (for audio/video).
transcriber:
  url: http://localhost:8090
  timeout-secs: 120

# Groq fallback transcription (Whisper-large-v3 via API).
# API key is read from the named environment variable.
groq:
  api-key: GROQ_API_KEY
  model: whisper-large-v3

# LLM used by the distillation pipeline. Provider: claude | openai.
llm:
  provider: claude
  model: claude-sonnet-4-6
  # Env var (or file) holding the Anthropic key. Also the `anthropic` entry
  # of api-keys below; naming a different var there is a load error.
  api-key: ANTHROPIC_API_KEY
  # Per-vendor key vars for `sb borg eval`'s fabric judges. Each value is
  # exported under fabric's own name (ANTHROPIC_API_KEY, GEMINI_API_KEY,
  # OPENAI_API_KEY) on the fabric child only, so `--judge-model gemini-...`
  # needs no key in fabric's .env. Vendors: anthropic, gemini, openai.
  # api-keys:
  #   gemini: GEMINI_API_KEY
  #   openai: OPENAI_API_KEY

# Telegram bot — primary ingestion input.
# allowed-chat-ids gates which chats borg listens to.
telegram:
  bot-token: TELEGRAM_BOT_TOKEN
  allowed-chat-ids: []
  host: desk

# Discord bot — optional secondary input.
# discord:
#   bot-token: DISCORD_BOT_TOKEN
#   channel-id: 0

# ntfy — optional push-to-ingest input. SECURITY: ntfy's only access control
# is the topic NAME, which travels in cleartext URLs and is trivially guessable
# on public servers. Therefore borg IGNORES `force` from ntfy messages (a
# force-overwrite must never be triggerable by someone who guesses the topic).
# Use a long, RANDOM, reserved topic AND set ntfy.token (an access token for a
# private/ACL-protected topic) - do NOT rely on the topic name alone.
# `read-timeout` (humantime) is the longest silence tolerated before the
# subscription is dropped and reconnected; keep it above the server's
# keepalive interval (ntfy.sh sends one every 45s; default is 3x that).
# ntfy:
#   server: https://ntfy.sh
#   topic: borg-<long-random-string>
#   token: NTFY_TOKEN
#   host: desk
#   read-timeout: 135s

# Signal transport — peer to Telegram with end-to-end-encrypted envelope
# routing. Bootstrap is out-of-band: stop borg, run
#   signal-rs link --name borg --state-dir ~/.local/share/sb/borg/signal-state/
# (use this exact path on Linux; macOS substitutes
# ~/Library/Application Support/sb/borg/signal-state/) on the host that
# should run Signal ingest, scan the QR with the primary phone (Settings
# -> Linked Devices), uncomment the block below, then restart borg. The
# state-dir is owned internally by borg (vault::paths::borg_signal_state_dir);
# it is NOT a config field. `host` is MANDATORY (hostname of the machine
# that runs ingest); Signal-Server fans Note-to-Self envelopes to every
# linked device, so leaving `host` unset on a multi-machine install would
# silently double-ingest.
# signal:
#   allowed-senders: []         # peer ACI UUIDs allowed to send borg material
#   # notification-recipient defaults to Note-to-Self (your own account)
#   host: desk
#   # notetoself-rate-threshold-per-hour: 100  # default; raise only after a documented baseline reason

# Desktop notifications - peer to the Telegram notifier. Renders the same
# Processing... -> Saved/Duplicate/Failed messages via libnotify (user
# session D-Bus). host-gated like telegram/discord/ntfy so headless borg
# hosts stay silent.
desktop:
  enabled: true
  host: desk
  timeout-ms: 5000
  appname: borg

# YouTube ingestion settings.
# `slides.enabled: false` surgically disables frame capture only; audio, Whisper
# transcript, summary, classify, and publish all continue unchanged.
#
# `content-filter`: when enabled, every unique slide run is classified by a
# vision model and only slides whose category appears in `keep` at/above
# `min-confidence` are embedded in the published note.
# Taxonomy: architecture-diagram, sequence-diagram, flowchart, code, terminal,
#            infographic, chart, app-ui, webpage, talking-head, b-roll, title-card, other
# Unknown category strings are a hard parse error at config load.
#
youtube:
  slides:
    enabled: true
    content-filter:
      enabled: true
      keep: [architecture-diagram]
      model: ""               # empty = inherit llm.model
      max-vision-concurrency: 4
      min-confidence: 0.6
  # YouTube's session rate limit answers every video "Video unavailable".
  # After this many failed metadata fetches in a row, every YouTube fetch
  # fails fast for `pause-for` (humantime) instead of hitting the account
  # again. Defaults shown.
  # Before pausing, `canary-url` (or the last video that fetched cleanly) is
  # fetched again: if it still works, the failures were dead videos.
  pause-after-failures: 5
  pause-for: 30m
  canary-url: https://www.youtube.com/watch?v=jNQXAC9IVRw
  # Which implementation fetches a video's metadata and transcript.
  #   engine: yt-dlp | gemini     (default yt-dlp: today's behavior)
  #   fallback: yt-dlp | gemini   (default none; must differ from engine)
  # `gemini` reads metadata from the YouTube Data API and the timestamped
  # transcript from Gemini, with no yt-dlp call. When it errors and `fallback`
  # is set, the other engine runs and the receipt is marked degraded.
  # `api-key` is an env var NAME (the daemon gets the values from borg.env),
  # never the key itself. Durations are humantime. Defaults shown, except
  # engine/fallback, which are the opt-in.
  # engine: gemini
  # fallback: yt-dlp
  # gemini:
  #   model: gemini-3.8-flash
  #   api-key: GEMINI_API_KEY
  #   window: 30m     # clip length per call, at least 5m
  #   timeout: 5m     # one call, at least 30s
  #   budget: 15m     # all windows plus retries, at least timeout
  # data-api:
  #   api-key: YOUTUBE_API_KEY
  #   timeout: 30s    # one videos.list / channels.list call, at least 1s
  # The gemini budget covers the whole gemini fetch, Data API included: each
  # Data API call gets the smaller of data-api.timeout and the budget left.
  # The keys are checked when the daemon starts (gemini with no fallback and
  # an empty key refuses to start; with a fallback it WARNs), never on other
  # `sb borg` commands, which run in shells without borg.env.

# Where first-party clients (sb borg ingest/reingest/replay/queue/wait, the
# oracle ingest_queue tool) reach the daemon. `request-timeout` (humantime)
# bounds one request: connect, headers and body together. Defaults shown.
# hotkey:
#   host: localhost
#   port: 8181
#   request-timeout: 10s

# Pipeline network and subprocess bounds. `browser-ua-timeout` (humantime)
# bounds the browser-UA article fallback's HTTP fetch and, separately, its
# markitdown conversion; `github-timeout` bounds each GitHub REST request for
# a repo URL. The other `*-timeout-secs` keys are plain seconds. Defaults shown.
# pipeline:
#   browser-ua-timeout: 30s
#   github-timeout: 30s

# Tag pipeline. `canonical-path` / `mapping-path` default to the shared files
# `sb bootstrap` drops into ~/.config/sb/; `reject-concatenated` refuses tags
# like `machinelearning` that concatenate two canonical ones.
tags:
  # canonical-path: ~/.config/sb/canonical-tags.yml
  # mapping-path: ~/.config/sb/tag-mapping.yml
  # reject-concatenated: true
  # The closed-vocabulary tag classifier (`distillers::tags`). Same block, same
  # shape, in the other subsystem's config; both parse it through
  # `TagsClassifierConfig`. The nesting is load-bearing: `tags.classifier` is
  # a struct, not a scalar, so the kind goes on the inner `classifier:` key.
  classifier:
    # deterministic | jev | fabric-closed. The shipped default is
    # `deterministic`: it maps a note's existing tags and author-tags through
    # the canonical vocabulary locally and never calls out. `jev` asks the
    # TypeSafe jev model to pick tags from the vocabulary over HTTP (needs
    # network and the key below; each tag's `descriptions:` entry in
    # canonical-tags.yml rides along); `fabric-closed` asks the configured
    # fabric model to pick from the vocabulary (needs the `fabric`/`llm`
    # credential).
    classifier: deterministic
    # Minimum score a jev tag needs to be kept.
    # threshold: 0.9
    # Runs when the selected implementation errors. Borg marks the receipt
    # degraded; cortex holds the note only if this also returns Low.
    # fallback: deterministic
    # NAME of the env var holding the TypeSafe key (or a secret file path),
    # never the key itself; supply the value via env-bootstrap. A name that
    # resolves empty fails every jev classify, so the fallback runs.
    # api-key: ESCOTE_TYPESAFE_API_KEY
    # The jev model id sent on every request.
    # model: jev-latest
    # timeout-secs: 30

# Distillation feature toggles (all default-on; set false to disable a feature).
# Omitting this section (or any individual key) keeps today's shipped behavior.
distill:
  slide-append:  true   # append distilled sections below the slide body on slide-published videos
  capture-note:  true   # thread the capture note into ## Why Captured + capture-note frontmatter + distiller context
  propose-tags:  true   # merge distiller-proposed candidate tags into the tag pipeline
  chunk-retries: 1      # retries per failed/unparseable harvest sub-chunk before it degrades the reduce (0 = no retry)

# Harvest - `sb borg harvest` pulls clyde session-export candidates, selects
# the sessions worth remembering, distills each into a note, and lands it in
# the vault inbox through borg's normal pipeline. See
# docs/design/2026-07-17-harvest-clyde-sessions.md.
# Omitting this section (or any individual key) keeps the defaults shown below.
harvest:
  # Absolute path to the clyde binary. Tilde-expanded at load. Must be
  # absolute (not just resolvable via PATH): the nightly systemd timer runs
  # with a stripped PATH, so a bare "clyde" would not resolve there.
  clyde-binary: ~/.cargo/bin/clyde
  # First-run backfill bound. When no watermark cursor exists yet (e.g. a
  # fresh install), `sb borg harvest` scans back this far via
  # `clyde session export --since <this>` instead of inhaling the whole
  # catalog unasked. A deliberate deep backfill is `sb borg harvest --since 90d`
  # on the CLI, which overrides this for that one run.
  initial-since: 7d
  # What the nightly timer runs: dry-run (list selections/rejections, write
  # nothing) or live (publish notes). Defaults to dry-run so a fresh install
  # never lands notes unattended before the first-week soak; flip to live
  # once the selection bar looks right. An explicit `--dry-run` on the CLI
  # always overrides this, regardless of setting.
  mode: dry-run
  # Selection floor: a session with fewer than this many messages is a
  # one-shot, not substantive enough to earn a note. Tuned against the real
  # 2026-07-02 catalog: one-shots are <=3 messages, substantive threads >=29,
  # so 6 sits inside that gap with margin.
  min-msgs: 6
  # Dormancy horizon: a session is harvestable once idle this long (1d, 24h).
  # Forwarded to `clyde session export --dormant-after`. Omitting the key
  # keeps 7d (clyde's own default). CAVEAT: selection also requires clyde's
  # enrichment to have run, and the nightly clyde-enrich.service gates on ITS
  # own --dormant-after (7d unless its unit carries an override) - the
  # effective latency is the max of the two, so lower both together.
  dormant-after: 1d
  # Regex patterns matched against a session's title/first-prompt; a match
  # excludes the candidate before scoring (e.g. auto-fired security reviews,
  # bare "sure"/empty prompts, navigational lookups). Space/repeated-flag
  # semantics on the CLI equivalent; here it is a plain YAML list - never
  # comma-delimited.
  exclude-patterns:
    - '^Review this change for security vulnerabilities'
    - '^You previously flagged these candidate vulnerabilities'
    - '^You are a per-PR maintenance agent for the babysit-prs skill'
    - '^You are a \*\*self-review\*\* agent'
    - '^reply with exactly:'
    - '^Write one sentence summarizing the JSON on stdin'
  # Inter-session gap that splits two sessions sharing the same (cwd,
  # git-branch) into separate thread notes instead of merging them into one.
  # A human-time span (e.g. 2h, 90m).
  thread-window: 2h
  # Hard cap on tokens fed to the distiller per thread (head+tail windowing
  # for very long threads), independent of the selection thresholds above.
  token-cap: 12000
  # Model override for the harvest distillation pass. Empty string (the
  # default) inherits llm.model above.
  model: ""
  # systemd OnCalendar for the nightly timer (`sb borg harvest --install`).
  # The ONE value baked into the .timer unit; every knob above stays here in
  # config. Standard systemd calendar spec (daily | *-*-* 03:00:00 | ...).
  schedule: "*-*-* 03:00:00"
  # Optional secret/env bootstrap for the installed sb-harvest.service unit:
  # `command`'s stdout is captured into `env-file` via an ExecStartPre shell
  # redirect, then the unit loads it with `EnvironmentFile=-<env-file>`.
  # MANDATORY if fabric needs a decrypted secret (e.g. ANTHROPIC_API_KEY) to
  # distill - systemd timers run with a stripped environment, so without this
  # the nightly run has no key and every note lands degraded. Use a DISTINCT
  # env-file from the daemon's so the one-shot timer run never clobbers the
  # long-running daemon's captured environment. Omit this whole block on a
  # host with no secrets to bootstrap - the generated unit is still valid.
  # env-bootstrap:
  #   command: manifest age decrypt ~/repos/scottidler/keep/.secrets -f env
  #   env-file: /run/user/1000/sb-harvest.env

# Daily eval (sb-eval.timer): `sb borg eval --unscored` scores every successful
# ingest still in staging and records each check in eval_scores. A trace is
# covered when every deterministic check and both judge checks of EVERY model
# in `judge-models` have a current, error-free row. The default list is
# gemini-2.5-pro (the default judge: the distiller is Anthropic) then
# claude-sonnet-5 (the second judge), so every note is judged by two vendors
# and `--inject` prints their pairwise kappa. The first entry is also the
# model `sb borg eval --staged` judges with when --judge-model is not given. `sb bootstrap` writes and enables the units and
# refuses to when llm.api-keys is set but `env-bootstrap` is not: the service
# runs with a stripped environment and must decrypt every var llm.api-keys
# names (anthropic/gemini/openai) into its OWN env-file.
# eval:
#   schedule: "*-*-* 05:00:00"        # systemd OnCalendar, the one value in the timer
#   limit: 100                        # traces per run; the rest carry over (omit = all)
#   judge-models:
#     - gemini-2.5-pro                # the default judge (first entry)
#     - claude-sonnet-5               # the second judge
#   env-bootstrap:
#     command: manifest -C ~/repos/scottidler/keep/manifest.yml secrets env -f env
#     env-file: /run/user/1000/sb-eval.env
#   # `sb borg eval --inject` plants errors (number-swap, fabricated-quote,
#   # dropped-top-claim, who-change) into a staged sample and writes one
#   # judge_trust row per judge model, check and class the check can see. A
#   # judge check is trusted when its paired catch rate (flags the mutant AND
#   # passes its original) clears min-paired-catch-rate over at least
#   # min-samples traces on every class it can see, on the current rubric.
#   # Both are policy floors: 24 of 30 has a Wilson lower bound near 0.66.
#   trust:
#     min-paired-catch-rate: 0.80
#     min-samples: 30                 # also the default --inject --sample
#   inject-workers: 4                 # traces judged in parallel by --inject
#   # A candidate distill pattern (`sb borg eval --candidate-pattern`, the
#   # `otto gepa` search, `--apply-candidate`) scores quote grounding x claim
#   # support x listicle survival against the current pattern. Cutting claims
#   # per note or enumeration items per note by more than max-coverage-cut
#   # scores it 0, so a pattern cannot win by saying less.
#   candidate:
#     max-coverage-cut: 0.10
#     distill-workers: 4              # distills in flight while scoring

# Intake - raw-input sidecars. Every trace gets <vault>/system/intake/<trace>.txt
# holding the verbatim bytes it arrived with (or a short descriptor for binary
# input). Nothing in the pipeline READS these; they exist so you can answer
# "what exactly did borg receive for trace X?" after the fact.
intake:
  # Days to keep a sidecar, from its mtime. 0 = keep forever (no sweep). This is
  # a forensics window, not an archive: nothing reads these files, so a short
  # window is the point. Swept daily by the daemon and on demand via
  # `sb borg retention sweep [--sidecars-only] [--dry-run]`.
  retention-days: 21

# Source archive - the durable copy of every distilled URL source. Each video,
# article, repo and thread ingest writes <root>/<trace>/distilled.yml (plus the
# repo README or thread markdown as transcript.md) BEFORE the vault note, with
# or without staging. A failed archive write fails the trace `publish-failed`
# and no note lands. Nothing sweeps it, unlike staging. `GET /trace/<id>`
# reports `source-durable: true` once a trace's archive dir exists. cortex's
# top-level `archive-root` must name the same directory.
# archive:
#   root: ~/.local/share/sb/borg/sources

# Ingest queue - what `GET /queue`, `sb borg queue`, `sb borg wait` and the
# oracle `ingest_queue` tool report. Durations are humantime strings (15m, 90s);
# a bad value fails the config load naming the key.
queue:
  # In flight longer than this (since permit grant, or since receipt if never
  # granted) is reported wedged. Measured worst single item (receipt ->
  # terminal, incl. permit wait), last 60 days: 537s (cli youtube). The
  # watchdog reaps at hard-timeout-secs + 60 = 1860s.
  wedged-after: 15m
  # Receipts whose [received, finished] spans are this close join one batch.
  # Covers clicks that arrive after an earlier fast item already finished.
  batch-gap: 2m

# Log level: trace | debug | info | warn | error
log-level: info
