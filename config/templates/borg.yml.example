# borg config - Obsidian ingestion daemon
# Installed by `sb bootstrap` to ~/.config/sb/borg.yml if absent.
# Fields use kebab-case; the Rust struct (borg::config::Config) translates to snake_case via serde.

server:
  # Default bind is 0.0.0.0 to preserve the LAN ingest path (e.g. the laptop's
  # Firefox extension POSTing to desk.lan:8181). On an exposed network the
  # write routes (/ingest, /ingest/file, /note) are reachable by anyone who can
  # reach this port unless you set auth-token below; /health* stays open.
  host: "0.0.0.0"
  port: 8181
  # Optional bearer-token auth for the write routes. Like telegram.bot-token,
  # this is a secret REFERENCE - an env-var name or a file path - resolved at
  # startup, NOT a literal token. When set, requests must carry
  # `Authorization: Bearer <resolved-token>`; configure the same token in the
  # Firefox extension options. When unset, the routes are unauthenticated
  # (backward compatible). On a non-loopback bind with no token, the daemon
  # logs a WARN at startup naming the exposure.
  # auth-token: BORG_AUTH_TOKEN

vault:
  # Set root-path to your Obsidian vault, or leave it commented out and
  # pass --vault on the CLI / run from a directory containing a .obsidian/
  # subdirectory. With root-path unset, the resolver errors with a clear
  # "vault root not set" message rather than guessing.
  # root-path: ~/path/to/your/vault
  inbox-path: inbox
  vault-name: obsidian

# Local Whisper transcription service (for audio/video).
transcriber:
  url: http://localhost:8090
  timeout-secs: 120

# Groq fallback transcription (Whisper-large-v3 via API).
# API key is read from the named environment variable.
groq:
  api-key: GROQ_API_KEY
  model: whisper-large-v3

# LLM used by the distillation pipeline. Provider: claude | openai.
llm:
  provider: claude
  model: claude-sonnet-4-6
  api-key: ANTHROPIC_API_KEY

# Telegram bot — primary ingestion input.
# allowed-chat-ids gates which chats borg listens to.
telegram:
  bot-token: TELEGRAM_BOT_TOKEN
  allowed-chat-ids: []
  host: desk

# Discord bot — optional secondary input.
# discord:
#   bot-token: DISCORD_BOT_TOKEN
#   channel-id: 0

# ntfy — optional push-to-ingest input. SECURITY: ntfy's only access control
# is the topic NAME, which travels in cleartext URLs and is trivially guessable
# on public servers. Therefore borg IGNORES `force` from ntfy messages (a
# force-overwrite must never be triggerable by someone who guesses the topic).
# Use a long, RANDOM, reserved topic AND set ntfy.token (an access token for a
# private/ACL-protected topic) - do NOT rely on the topic name alone.
# ntfy:
#   server: https://ntfy.sh
#   topic: borg-<long-random-string>
#   token: NTFY_TOKEN
#   host: desk

# Signal transport — peer to Telegram with end-to-end-encrypted envelope
# routing. Bootstrap is out-of-band: stop borg, run
#   signal-rs link --name borg --state-dir ~/.local/share/sb/borg/signal-state/
# (use this exact path on Linux; macOS substitutes
# ~/Library/Application Support/sb/borg/signal-state/) on the host that
# should run Signal ingest, scan the QR with the primary phone (Settings
# -> Linked Devices), uncomment the block below, then restart borg. The
# state-dir is owned internally by borg (vault::paths::borg_signal_state_dir);
# it is NOT a config field. `host` is MANDATORY (hostname of the machine
# that runs ingest); Signal-Server fans Note-to-Self envelopes to every
# linked device, so leaving `host` unset on a multi-machine install would
# silently double-ingest.
# signal:
#   allowed-senders: []         # peer ACI UUIDs allowed to send borg material
#   # notification-recipient defaults to Note-to-Self (your own account)
#   host: desk
#   # notetoself-rate-threshold-per-hour: 100  # default; raise only after a documented baseline reason

# Desktop notifications - peer to the Telegram notifier. Renders the same
# Processing... -> Saved/Duplicate/Failed messages via libnotify (user
# session D-Bus). host-gated like telegram/discord/ntfy so headless borg
# hosts stay silent.
desktop:
  enabled: true
  host: desk
  timeout-ms: 5000
  appname: borg

# YouTube ingestion settings.
# `slides.enabled: false` surgically disables frame capture only; audio, Whisper
# transcript, summary, classify, and publish all continue unchanged.
#
# `content-filter`: when enabled, every unique slide run is classified by a
# vision model and only slides whose category appears in `keep` at/above
# `min-confidence` are embedded in the published note.
# Taxonomy: architecture-diagram, sequence-diagram, flowchart, code, terminal,
#            infographic, chart, app-ui, webpage, talking-head, b-roll, title-card, other
# Unknown category strings are a hard parse error at config load.
#
youtube:
  slides:
    enabled: true
    content-filter:
      enabled: true
      keep: [architecture-diagram]
      model: ""               # empty = inherit llm.model
      max-vision-concurrency: 4
      min-confidence: 0.6

# Distillation feature toggles (all default-on; set false to disable a feature).
# Omitting this section (or any individual key) keeps today's shipped behavior.
distill:
  slide-append:  true   # append distilled sections below the slide body on slide-published videos
  capture-note:  true   # thread the capture note into ## Why Captured + capture-note frontmatter + distiller context
  propose-tags:  true   # merge distiller-proposed candidate tags into the tag pipeline
  chunk-retries: 1      # retries per failed/unparseable harvest sub-chunk before it degrades the reduce (0 = no retry)

# Harvest - `sb borg harvest` pulls clyde session-export candidates, selects
# the sessions worth remembering, distills each into a note, and lands it in
# the vault inbox through borg's normal pipeline. See
# docs/design/2026-07-17-harvest-clyde-sessions.md.
# Omitting this section (or any individual key) keeps the defaults shown below.
harvest:
  # Absolute path to the clyde binary. Tilde-expanded at load. Must be
  # absolute (not just resolvable via PATH): the nightly systemd timer runs
  # with a stripped PATH, so a bare "clyde" would not resolve there.
  clyde-binary: ~/.cargo/bin/clyde
  # First-run backfill bound. When no watermark cursor exists yet (e.g. a
  # fresh install), `sb borg harvest` scans back this far via
  # `clyde session export --since <this>` instead of inhaling the whole
  # catalog unasked. A deliberate deep backfill is `sb borg harvest --since 90d`
  # on the CLI, which overrides this for that one run.
  initial-since: 7d
  # What the nightly timer runs: dry-run (list selections/rejections, write
  # nothing) or live (publish notes). Defaults to dry-run so a fresh install
  # never lands notes unattended before the first-week soak; flip to live
  # once the selection bar looks right. An explicit `--dry-run` on the CLI
  # always overrides this, regardless of setting.
  mode: dry-run
  # Selection floor: a session with fewer than this many messages is a
  # one-shot, not substantive enough to earn a note. Tuned against the real
  # 2026-07-02 catalog: one-shots are <=3 messages, substantive threads >=29,
  # so 6 sits inside that gap with margin.
  min-msgs: 6
  # Regex patterns matched against a session's title/first-prompt; a match
  # excludes the candidate before scoring (e.g. auto-fired security reviews,
  # bare "sure"/empty prompts, navigational lookups). Space/repeated-flag
  # semantics on the CLI equivalent; here it is a plain YAML list - never
  # comma-delimited.
  exclude-patterns: []
  # Inter-session gap that splits two sessions sharing the same (cwd,
  # git-branch) into separate thread notes instead of merging them into one.
  # A human-time span (e.g. 2h, 90m).
  thread-window: 2h
  # Hard cap on tokens fed to the distiller per thread (head+tail windowing
  # for very long threads), independent of the selection thresholds above.
  token-cap: 12000
  # Model override for the harvest distillation pass. Empty string (the
  # default) inherits llm.model above.
  model: ""
  # systemd OnCalendar for the nightly timer (`sb borg harvest --install`).
  # The ONE value baked into the .timer unit; every knob above stays here in
  # config. Standard systemd calendar spec (daily | *-*-* 03:00:00 | ...).
  schedule: "*-*-* 03:00:00"
  # Optional secret/env bootstrap for the installed sb-harvest.service unit:
  # `command`'s stdout is captured into `env-file` via an ExecStartPre shell
  # redirect, then the unit loads it with `EnvironmentFile=-<env-file>`.
  # MANDATORY if fabric needs a decrypted secret (e.g. ANTHROPIC_API_KEY) to
  # distill - systemd timers run with a stripped environment, so without this
  # the nightly run has no key and every note lands degraded. Use a DISTINCT
  # env-file from the daemon's so the one-shot timer run never clobbers the
  # long-running daemon's captured environment. Omit this whole block on a
  # host with no secrets to bootstrap - the generated unit is still valid.
  # env-bootstrap:
  #   command: manifest age decrypt ~/repos/scottidler/keep/.secrets -f env
  #   env-file: /run/user/1000/sb-harvest.env

# Log level: trace | debug | info | warn | error
log-level: info
