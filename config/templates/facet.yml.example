# facet config - dialog-slice gem harvester for Claude Code JSONL transcripts.
# Lives at ~/.config/sb/facet.yml. Tilde-prefixed paths are expanded at load
# time. All values shown are the built-in defaults; uncomment + tweak only
# what differs.

# Source of JSONL transcripts.
# claude-projects-root: ~/.claude/projects

# Cadence. harvest-interval runs scan -> cluster -> extract -> render every
# <secs>; narrate-interval runs Session Arc + Cross-Session Arc discovery +
# synthesis; dream-interval runs semantic-duplicate / cross-reference /
# stale-spectrum / narrative-candidate proposals. Set any cadence to 0 to
# disable that pass in the daemon loop.
# harvest-interval-secs: 86400        # daily
# narrate-interval-secs: 604800       # weekly
# dream-interval-secs: 86400          # daily

# Scope. An empty include-cwds means "all roots not in exclude-cwds".
# Excludes win on overlap. Match is path-prefix on tilde-expanded values.
# include-cwds:
#   - ~/repos/scottidler
exclude-cwds:
  - ~/repos/tatari-tv
  - ~/repos/scottidler/obsidian

# LLM tiering, models, and budget caps.
# Model names must match what `fabric --listmodels` reports on this
# machine. Update via `fabric --listmodels` if these stop resolving.
llm:
  cluster-model: claude-haiku-4-5
  extract-model: claude-sonnet-4-6
  spectra-model: claude-opus-4-7
  per-tick-budget-usd: 5.00
  per-day-budget-usd: 20.00
  fabric-binary: fabric
  timeout-secs: 180

# Concurrency caps. See docs/design/2026-05-12-borg-pipeline-concurrency-caps.md.
concurrency:
  max-sessions-per-tick: 16
  max-llm-inflight: 4
  parse-rayon-threads: 4

# Work-item dormancy. Mark dormant after N days with no new contribution.
dormancy:
  inactive-days: 14

# Vault output layout under the resolved vault root.
# prisms   = canonical capture (one prism note per work-item, body is an
#            ordered sequence of gems)
# spectra  = synthesis layer (one spectrum note per discovered narrative)
# dreams   = non-destructive proposals (dedup, cross-ref, stale-spectrum)
# quarantine = failure landings for parse errors
vault:
  prisms-dir: notes/facet/prisms
  spectra-dir: notes/facet/spectra
  dreams-dir: notes/facet/dreams
  quarantine-dir: notes/facet/quarantine
  archive-dir: notes/facet/archive

# Optional notifications.
notify:
  on-new-workitem: false
  on-budget-exhausted: true

# Extraction-stage tuning.
extract:
  quote-max-chars: 800
  max-input-tokens: 60000
