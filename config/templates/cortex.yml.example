# cortex config - Obsidian vault governance daemon
# Installed by `sb bootstrap` to ~/.config/sb/cortex.yml if absent.
# Full schema: see cortex/src/config.rs in the second-brain workspace.

# Vault root. Required for cortex to know which Obsidian vault to operate on.
# Set root-path to your Obsidian vault, or leave it commented out and pass --vault
# on the CLI / run from a directory containing a .obsidian/ subdirectory. With
# root-path unset, the resolver errors with a clear "vault root not set" message.
vault:
  # root-path: ~/path/to/your/vault

# Embedding pipeline (Phase A: summary embeddings; Phase B: transcript chunks).
embedding:
  enabled: true
  # active-model is pinned in the DB via embedding_config; this is the bootstrap default.
  active-model: bge-small-en-v1.5
  batch-size: 64

# Embed loop knobs. `kinds` gates which embedding kinds the default (no-`--kind`)
# `sb cortex embed` / `--backfill` pass and the daemon embed tick generate. The
# daemon has no per-invocation CLI surface, so this selection lives in config
# (the "methodology selection is legitimate config" carve-out, mirroring
# oracle.yml's per-method `enabled` flags). An explicit `sb cortex embed --kind
# claim` still forces claim embedding regardless of this toggle (CLI > config).
embed:
  # Size of the DEDICATED inference thread pool. Candle's matmul fans out on
  # rayon; embed installs its own pool so that fan-out can never consume the
  # workers governance actions (classify/lint/link/quality/auto-tag) run their
  # par_iter on. 0 means "small fixed default" (2), NOT core count: "as many
  # replicas as cores" is what caused the contention this pool exists to
  # prevent. Read once per process - restart the daemon to change it.
  # workers: 2
  # Hard ceiling on chunks embedded per tick, across all notes. `batch-size`
  # bounds NOTES (64), not chunks, and one long transcript can chunk into
  # hundreds - so a tick had no wall-clock bound at all. On 2026-08-16 a single
  # tick on an AVX-only host ran for TWO DAYS, held the shared rayon pool, and
  # starved classify so 50 harvested notes sat unfiled while systemd still
  # reported the daemon `active (running)`. Truncation is free: deferred notes
  # keep their stale marker and lead the next tick. 0 disables the cap.
  # max-chunks-per-tick: 512
  kinds:
    summary: true
    transcript-chunk: true
    # claim is DEFAULT-OFF pending the kind-weighted-pooling contingency: the
    # v0.9.0 claim-embedding rollout regressed retrieval and the live
    # `sb oracle eval` gate failed 2026-07-05 (nDCG 0.8795 -> 0.8471). Leave OFF
    # to keep the claim-free baseline; flip to true only for the guard-first
    # claim experiment.
    claim: false
  # Root of borg's per-trace staging directories. cortex reads the staged
  # distilled.yml (read-only) as the transcript-embedding source for
  # Video/Article notes, which no longer carry a `## Transcript` body section
  # (2026-07-07-distillation-output-restore). Defaults to borg's own staging
  # default (~/.local/share/sb/borg/stages); only set this if you overrode
  # borg's `staging.root` in borg.yml -- it must point at the SAME directory.
  # staging-root: ~/.local/share/sb/borg/stages

# Graph-augmented-memory edge layer (oracle reads; cortex writes). All fields
# optional; defaults live in cortex/src/config.rs GraphConfig.
graph:
  # Deterministic edge tick cadence (seconds). Default 900 (15 min).
  # graph-interval-secs: 900
  # Typed LLM `fact` layer: max ingested notes mined per backfill. Triple
  # extraction has NO advancing cursor, so this cap IS the coverage window -
  # set it above your ingested-note count for a full corpus sweep. Default 50.
  # fact-max-per-run: 1000
  # In-process daemon cadence (seconds) for the fact backfill. Runs the LLM
  # triple-extraction + consolidation layer; deterministic edges are handled by
  # the separate graph tick. In-process so it cannot collide with the embed tick
  # on the shared embed lock (a separate systemd timer would). Default 604800 (weekly).
  # fact-interval-secs: 604800
  # Wikilink targets that must never become a link, matched case-insensitively
  # on the RAW [[target]] before resolution. The auto-linker's blunt
  # `min-word-length` gate rewrites common English words into links to
  # short-titled hubs. One list, three consumers:
  #   - `sb cortex link`   refuses to WRITE the markup,
  #   - `sb cortex graph`  refuses to mint an EDGE from markup already landed,
  #   - `sb cortex unlink` retracts landed markup (reports by default,
  #                        rewrites note bodies with --apply).
  # The code default is EMPTY (nothing is suppressed unless you say so); these
  # two are the measured offenders on Scott's corpus (`every` alone minted 569
  # false edges into entities/every.md - the every.to publication hub - and
  # landed [[every]] in 707 note bodies).
  wikilink-stopwords:
    - every
    - brief

# `sb cortex entities --discover` (LLM glossary proposals) and, under
# `render:`, the DETERMINISTIC hub-body builder run by
# `sb cortex hub --synthesize --apply`. The builder makes zero LLM calls: a hub
# body is its members' already-distilled claims, grouped by ingestion vector,
# quoted and wikilinked. Defaults live in cortex/src/config.rs.
entities:
  render:
    # Members rendered per `## From sources` / `## From your sessions` section
    # before a deterministic `...and N more claim-bearing members` overflow
    # line. Obsidian's backlinks pane keeps the full membership visible.
    # Default 20.
    # max-members-per-section: 20
    # Claims rendered per member note, in note order. Default 3.
    # max-claims-per-member: 3
    # UTF-8 BYTE budget for the `## Summary` digest. Load-bearing for
    # retrieval: the summary is the ONLY embedding surface a hub has and the
    # encoder silently truncates at 512 tokens, so an unbounded digest makes
    # the scarcer vector invisible to search. The budget is split per vector
    # (sessions first, unused session bytes cede to sources). Default 1200
    # (~254 tokens on this corpus - it binds well before the tokenizer does).
    # summary-byte-budget: 1200
    # Mass-reset backstop: if resetting the bodies of hubs the builder had
    # PREVIOUSLY rendered would exceed this count, the run aborts before
    # writing anything and names the hubs. Raise it only when the resets are
    # genuinely intended. Default 20.
    # max-render-resets-per-run: 20

# `sb cortex associate`: groups harvest session notes sharing a
# content-derived `slug:` (borg's harvest naming, v0.12.2) and, per pairwise
# similarity, merges same-subject sessions or cross-links distinct-but-related
# ones. All fields optional; defaults live in cortex/src/config.rs
# AssociationConfig. Dry-run by default (`sb cortex associate`); `--apply`
# writes. The daemon tick is OFF by default - see `daemon.actions.association`
# below.
actions:
  association:
    # Merge iff pairwise similarity >= this. Default 0.85 (mirrors
    # actions.duplicates' threshold).
    # threshold: 0.85
    # Which similarity signal to compute: embedding | claim | both. Default
    # `both` (embedding cosine primary, claim TF-IDF fallback when a note has
    # no summary embedding) - selecting the active methodology is legitimate
    # config per the general.md carve-out.
    # similarity-source: both
    # Skip a note - and its WHOLE same-slug group, never a half-merged group -
    # modified within this many seconds, so an actively-edited note is never
    # merged mid-edit. Default 600 (10 min).
    # min-quiescence-secs: 600
    # Glob paths excluded from association entirely.
    # exclude:
    #   - "journal/**"
    # Daemon cadence (seconds) for the association tick, when enabled below.
    # Default 3600 (hourly).
    # interval-secs: 3600

# Daemon cadence (sweep loop interval).
daemon:
  embed-interval-secs: 600
  sweep-interval-secs: 3600
  # Per-action auto-apply toggles for the on-change sweep loop. `association`
  # is the exception: it has NO on-change behavior (a merge must never fire on
  # startup or every debounced watcher event) - enabling it here only turns on
  # the separate periodic tick cadenced by `actions.association.interval-secs`
  # above (default hourly). OFF by default.
  # actions:
  #   association:
  #     enable: true
  # Rayon thread-pool cap emitted into the installed systemd unit as
  # Environment="RAYON_NUM_THREADS=N" (candle's gemm degree reads the same
  # var, so this also bounds embedding fan-out). 0 (default) omits the line
  # entirely and lets rayon pick its own platform default. Set this to a
  # per-host tuning value (e.g. nproc/4) if bulk sweeps are pegging every core.
  # This pool serves GOVERNANCE only - embed inference has its own pool
  # (`embed.workers`), so it no longer needs to be starved down to protect
  # against a runaway embed. Do not set this small on a many-core box: that
  # throttles every sweep to guard against what pool isolation already prevents.
  # rayon-threads: 8
  # Optional secret/env bootstrap for the installed systemd unit: `command`'s
  # stdout is captured into `env-file` via an `ExecStartPre` shell redirect,
  # then the unit loads it with `EnvironmentFile=-<env-file>`. Omit this
  # whole block on a host with no secrets to bootstrap - the generated unit
  # is still valid without it.
  # env-bootstrap:
  #   command: manifest age decrypt ~/repos/scottidler/secrets/.secrets -f env
  #   env-file: /run/user/1000/cortex.env

# LLM used by intel / classify. Provider: claude | openai.
llm:
  provider: claude
  model: claude-sonnet-4-6
  api-key: ANTHROPIC_API_KEY

# Log level: trace | debug | info | warn | error
log-level: info
