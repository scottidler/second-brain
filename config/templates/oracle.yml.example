# oracle config - knowledge retrieval MCP server
# Installed by `sb bootstrap` to ~/.config/sb/oracle.yml if absent.
# Full schema: see oracle/src/config.rs in the second-brain workspace.

# Vault root. Set root-path to your Obsidian vault, or leave it commented out and
# launch oracle from a directory containing a .obsidian/ subdirectory. With root-path
# unset, oracle errors with a clear "vault root not set" message at startup.
vault:
  # root-path: ~/path/to/your/vault

# Vault file watcher. When enabled, the running MCP server reindexes on file changes.
watcher:
  enable: true
  debounce-secs: 2
  ignore:
    - .obsidian
    - .git
    - .trash

# How often the periodic inbound-link recompute task runs.
# 600 seconds = 10 minutes. Lower = fresher counts, more contention.
inbound-recompute-interval-secs: 600

# Logging — written via tracing-subscriber. Stays out of stdout (MCP JSON-RPC contract).
logging:
  level: info
  # file: ~/.local/share/oracle/logs/oracle.log
