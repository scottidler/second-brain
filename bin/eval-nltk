#!/usr/bin/env bash
# Provision NLTK's punkt_tab tokenizer into a private NLTK_DATA dir and print
# that dir on stdout. MiniCheck needs punkt_tab at runtime; the package does not
# ship it and `nltk.download` refuses to fetch it on this host, so `otto eval-py`
# fetches the pinned zip itself. Idempotent: a dir that already holds it is reused.
#
# usage: bin/eval-nltk [DEST]    (default: ~/.cache/sb/eval/nltk)
set -euo pipefail

DEST="${1:-${XDG_CACHE_HOME:-$HOME/.cache}/sb/eval/nltk}"
URL="https://raw.githubusercontent.com/nltk/nltk_data/gh-pages/packages/tokenizers/punkt_tab.zip"
SHA256="e57f64187974277726a3417ca6f181ec5403676c717672eef6a748a7b20e0106"

if [ -d "$DEST/tokenizers/punkt_tab" ]; then
  echo "$DEST"
  exit 0
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
curl -fsSL --retry 2 -o "$work/punkt_tab.zip" "$URL"
got="$(sha256sum "$work/punkt_tab.zip" | cut -d' ' -f1)"
if [ "$got" != "$SHA256" ]; then
  echo "eval-nltk: punkt_tab.zip sha256 is $got, expected $SHA256" >&2
  exit 1
fi
mkdir -p "$DEST/tokenizers"
python3 -m zipfile -e "$work/punkt_tab.zip" "$DEST/tokenizers"
[ -d "$DEST/tokenizers/punkt_tab" ] || { echo "eval-nltk: the zip did not hold punkt_tab" >&2; exit 1; }
echo "$DEST"
