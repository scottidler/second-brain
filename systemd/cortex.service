[Unit]
Description=cortex - Obsidian vault governance daemon (second-brain)
After=default.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/sb cortex daemon --start
Restart=on-failure
RestartSec=5
WorkingDirectory=%h

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/repos/scottidler/obsidian
PrivateTmp=true

# Per-machine config paths / environment overrides belong in a drop-in:
#   ~/.config/systemd/user/cortex.service.d/local.conf

[Install]
WantedBy=default.target
